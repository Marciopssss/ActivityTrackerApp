<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include database in cloud backup -->
        <include domain="database" path="activity_tracker_database"/>
    </cloud-backup>

    <device-transfer>
        <!-- Include all data in device transfer -->
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>